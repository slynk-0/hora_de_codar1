programa{
    funcao inicio(){
        inteiro n1, n2, n3, n4, n5, n6

        escreva("Digite os seis valores: \n")
        leia(n1)
        leia(n2)
        leia(n3)
        leia(n4)
        leia(n5)
        leia(n6)

        escreva("Valores inseridos:", n1, " ", n2," ", n3," ", n4, " ", n5 , " ",n6)

        inteiro media = (n1 + n2 + n3 + n4 + n5 + n6) / 6
        escreva("\nMédia aritmética ", media)
        
  
    }
}